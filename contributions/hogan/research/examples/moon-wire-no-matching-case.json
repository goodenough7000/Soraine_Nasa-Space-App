  "card": {
    "id": "wire",
    "title": "LDPE-coated NiCr wire",
    "summary": "Explore measured flame spread at Martian gravity.",
    "sections": [
      {
        "heading": "What the number describes",
        "body": "The study follows downward flame spread on a 150 mm wire with a 0.5 mm NiCr core and a 0.3 mm LDPE coating."
      },
      {
        "heading": "An observed mechanism",
        "body": "Molten coating can move cyclically ahead of the flame. These attached polymer droplets are different from the free water droplets in the galley."
      }
    ],
